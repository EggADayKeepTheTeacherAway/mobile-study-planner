<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <View
            android:id="@+id/viewIconBg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ic_color_circle"
            android:backgroundTint="#FDE8E8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivNotifyIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_error_24"
            app:layout_constraintBottom_toBottomOf="@id/viewIconBg"
            app:layout_constraintEnd_toEndOf="@id/viewIconBg"
            app:layout_constraintStart_toStartOf="@id/viewIconBg"
            app:layout_constraintTop_toTopOf="@id/viewIconBg"
            app:tint="@color/high_priority_text" />

        <TextView
            android:id="@+id/tvNotifyTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/viewUnread"
            app:layout_constraintStart_toEndOf="@id/viewIconBg"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Linear Algebra PS due today!" />

        <TextView
            android:id="@+id/tvNotifySubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/inactive_grey"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@id/tvNotifyTitle"
            app:layout_constraintStart_toStartOf="@id/tvNotifyTitle"
            app:layout_constraintTop_toBottomOf="@id/tvNotifyTitle"
            tools:text="Mathematics · Due at 11:59 PM" />

        <TextView
            android:id="@+id/tvNotifyTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/inactive_grey"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/tvNotifyTitle"
            app:layout_constraintTop_toBottomOf="@id/tvNotifySubtitle"
            tools:text="2h ago" />

        <View
            android:id="@+id/viewUnread"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/ic_color_circle"
            android:backgroundTint="@color/cgreen"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>